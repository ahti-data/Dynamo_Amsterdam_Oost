# Edit this per project.
# The workflow deploys to /apps/<APP_FOLDER>/ and creates that folder if needed.
# "dynamo" is already taken by the client dashboard, hence dynamo_internal.
# Login is handled by Authelia on healthinsights.ahti.nl, not by the app itself,
# so utils/auth.R (shinymanager) is deliberately not wired up here.
APP_FOLDER=dynamo_internal
