# === Dependencies ===
node_modules/

# === Build output ===
dashboard/dist/

# === Python caches ===
__pycache__/
*.pyc

# === Encrypted deploy artifacts (generated by deploy/encrypt_data.py on dist/) ===
**/*.enc
**/enc-meta.json

# === Large CBS source spreadsheets (kerncijfers wijken/buurten) ===
# Inputs for data-prep/build_data.py; downloadable from CBS. Kept out of git
# to avoid ~160 MB of binaries. Live in data-prep/kwb/ (patterns are unanchored).
kwb-*.xls
kwb-*.xlsx
kwb*.xlsx

# === Large downloaded raw external data (~1.1 GB) ===
# Regenerate with external-data/download_sources.py (see checksums.sha256 / manifest.json).
external-data/raw/

# === Local editor / agent settings ===
.claude/settings.local.json

# === OS noise ===
.DS_Store
Thumbs.db
